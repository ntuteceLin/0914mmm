let student = {
    name: "Eric",
    age: 50,
    grades: [95, 58 ,80 ,87],
    isGraduated: false
}

function calculateAve(grades) {
    let sum = 0;
    for (let i=0; i < grades.length; i++) {
        sum = sum + grades[i];
    }
    return sum / grades.length;
}

let averageGrade = calculateAve(student.grades)

